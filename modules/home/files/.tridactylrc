set hintfiltermode simple
set hintchars asdfjkl;gh

" ---- Scrolling (smaller steps, vim-like) ----
bind j scrollline 5
bind k scrollline -5
bind d scrollpage 0.5
bind u scrollpage -0.5
bind gg scrollto 0
bind G scrollto 100

" ---- Tabs ----
bind J tabnext
bind K tabprev
bind gd tabdetach
bind gD composite tabduplicate; tabdetach
bind d composite tabclose
bind u composite undo

" ---- Splits/windows via tab moves ----
bind gm tabmove +1
bind gM tabmove -1

" ---- Insert/edit mode: send textareas to your $EDITOR via native messenger ----
set editorcmd emacsclient -c

" ---- Quickmarks (edit to taste) ----
quickmark g https://github.com
quickmark n https://search.nixos.org/packages
quickmark o https://search.nixos.org/options
quickmark h https://home-manager-options.extranix.com

" ---- Search engines ----
set searchengine google
set searchurls.nixpkgs https://search.nixos.org/packages?query=%s
set searchurls.hmopts https://home-manager-options.extranix.com/?query=%s
set searchurls.gh https://github.com/search?q=%s
bind ;s composite fillcmdline open nixpkgs

" ---- Custom hint scopes (site-specific) ----
bindurl news.ycombinator.com f hint -c span.titleline
bindurl youtube.com f hint -Jc a#video-title, ytd-channel-name#channel-name
bindurl search.brave.com f hint -Jc div.title, a.enrichment-card-item, div.snippet-show-more > button, textarea, input

" ---- Ignore mode on sites that clash with keybinds ----
blacklistadd docs.google.com
blacklistadd mail.google.com/mail

" ---- Behavior ----
set allowautofocus false
set smoothscroll true
set tabsclosetoend false
autocmd TabEnter .* unfocus

" ---- Native messenger niceties ----
bind ZZ !s killall firefox

autocmd TabEnter .* reloadtheme
command reloadtheme composite colourscheme dark ; colourscheme matugen
bind ,r reloadtheme