#!/usr/bin/env bash
#
# bt-duo-audio -- play system audio through several Bluetooth headsets at once.
#
# Works on PipeWire (pipewire-pulse) by building a "combine sink": a virtual
# output that mirrors one stream to every connected Bluetooth A2DP sink.
#
# Typical use:
#   bt-duo-audio                # mirror to ALL connected BT devices, make it
#                               # the default output and move current streams
#   bt-duo-audio xm6 buds       # only devices whose name/description matches
#   bt-duo-audio --no-move      # leave currently playing streams alone
#   bt-duo-audio --no-default   # build the sink but keep the old default
#   bt-duo-audio --latency 200  # request 200 ms buffering on the combine sink
#   bt-duo-audio --list         # list eligible Bluetooth sinks
#   bt-duo-audio --status       # show what is currently mirrored
#   bt-duo-audio --stop         # tear it down and restore the old default
#
# Notes
#  * Both devices must be in an A2DP profile; the phones' HSP/HFP (mic) mode
#    cannot be combined. Use `pactl set-card-profile <card> a2dp-sink` if needed.
#  * Different headsets have different internal latency (here: AAC buds vs LDAC
#    headphones), so they may not be sample-perfect in sync. --latency only
#    nudges overall buffering. combine-sink does correct for clock drift.
#  * EasyEffects is handled: it follows the default output, so apps keep being
#    EQ'd (app -> easyeffects_sink -> bt_duo -> both headsets). The script also
#    re-pins the combine sink's per-slave links, which EasyEffects would
#    otherwise redirect to a single device and leave the other one silent.
#  * When stdout is not a TTY (called from another script, a Vicinae script, a
#    pipe, ...) all chatter is suppressed and only one short line is printed,
#    e.g. "bt_duo: on (2 devices)" or "bt_duo: off"; colours are disabled too.
#
# Requires: pactl (pipewire-pulse). Tested on PipeWire 1.6.x.

set -euo pipefail

SINK_NAME="bt_duo"
DESCRIPTION="Bluetooth Duo"
LATENCY=""
DO_MOVE=1
DO_DEFAULT=1
DO_COMPENSATE=1
MODE="start"
QUIET=""            # empty = decide from TTY, 1 = one-line output, 0 = verbose
FILTERS=()

STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/bt-duo-audio.prev-default"

if [ -t 1 ]; then
  C_INFO=$'\033[1;34m'; C_WARN=$'\033[1;33m'; C_ERR=$'\033[1;31m'; C_RST=$'\033[0m'
else
  C_INFO=; C_WARN=; C_ERR=; C_RST=
fi

info() { [ "$QUIET" = 1 ] && return 0; printf '%s==>%s %s\n' "$C_INFO" "$C_RST" "$*"; }
warn() { printf '%swarning:%s %s\n' "$C_WARN" "$C_RST" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$C_ERR" "$C_RST" "$*" >&2; exit 1; }

# One-line, colourless result for scripted/piped use.
summary() { printf '%s\n' "$*"; }

usage() {
  cat <<'EOF'
bt-duo-audio -- play system audio through several Bluetooth headsets at once.

Usage: bt-duo-audio [options] [device-filter ...]

  (no args)            mirror to ALL connected BT devices, make it the default
                       output and move current streams onto it
  <filter> ...         only devices whose name/description matches (e.g. xm6 buds)

Options:
  --no-move            leave currently playing streams where they are
  --no-default         build the sink but keep the old default output
  --no-compensate      disable cross-device latency compensation
  --latency MS         request MS milliseconds of buffering on the combine sink
  --sink NAME          name for the virtual sink (default: bt_duo)
  --list               list eligible Bluetooth sinks
  --status             show what is currently mirrored
  --is-active          exit 0 if the combine sink is running, 1 otherwise
  -q, --quiet          only print a one-line result (implied when piped)
  --verbose            force the full human-readable output
  --stop, --off        tear it down and restore the previous default output
  -h, --help           show this help

Both devices must be in an A2DP profile (not HSP/HFP mic mode). Different
headsets still have different internal latency, so sync will not be perfect.
EOF
  exit 0
}

# ---------------------------------------------------------------- arg parsing
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)      usage ;;
    --stop|--off)   MODE="stop" ;;
    -q|--quiet)     QUIET=1 ;;
    --verbose)      QUIET=0 ;;
    --status)       MODE="status" ;;
    --is-active)    MODE="is-active" ;;
    --list)         MODE="list" ;;
    --move)         DO_MOVE=1 ;;
    --no-move)      DO_MOVE=0 ;;
    --default)      DO_DEFAULT=1 ;;
    --no-default|--no-set-default) DO_DEFAULT=0 ;;
    --compensate)   DO_COMPENSATE=1 ;;
    --no-compensate) DO_COMPENSATE=0 ;;
    --sink)         SINK_NAME="${2:?--sink needs a name}"; shift ;;
    --sink=*)       SINK_NAME="${1#*=}" ;;
    --latency)      LATENCY="${2:?--latency needs milliseconds}"; shift ;;
    --latency=*)    LATENCY="${1#*=}" ;;
    --)             shift; while [ $# -gt 0 ]; do FILTERS+=("$1"); shift; done; break ;;
    -*)             die "unknown option: $1 (try --help)" ;;
    *)              FILTERS+=("$1") ;;
  esac
  shift
done

command -v pactl >/dev/null || die "pactl not found -- is pipewire-pulse running?"

# Called from another script / piped? Then keep it to a single short line.
if [ -z "$QUIET" ]; then
  if [ -t 1 ]; then QUIET=0; else QUIET=1; fi
fi

# --------------------------------------------------------------- helpers
# Print "<sink_name>\t<description>" for every connected Bluetooth A2DP sink.
bt_sinks() {
  pactl list sinks | awk -v RS= '
    /Name: bluez_output\./ {
      match($0, /Name: [^\n]+/);        n = substr($0, RSTART+6,  RLENGTH-6);
      d = "";
      if (match($0, /Description: [^\n]+/)) d = substr($0, RSTART+13, RLENGTH-13);
      if (n ~ /monitor/) next;
      printf "%s\t%s\n", n, d;
    }'
}

# Ids of combine-sink modules we created (any sink_name == $SINK_NAME).
combine_modules() {
  pactl list modules | awk -v RS= -v pat="sink_name=$SINK_NAME([^A-Za-z0-9_]|$)" '
    $0 ~ pat { idx=$2; sub(/^#/, "", idx); print idx }'
}

# Comma separated slave list of the active combine sink (empty if none).
combine_slaves() {
  pactl list modules | awk -v RS= -v pat="sink_name=$SINK_NAME([^A-Za-z0-9_]|$)" '
    $0 ~ pat && match($0, /slaves=[^ \n]+/) { print substr($0, RSTART+7, RLENGTH-7); exit }'
}

default_sink() { pactl get-default-sink 2>/dev/null || true; }

# Move playback streams onto $1, leaving EasyEffects' virtual sink alone so its
# EQ keeps being applied (EasyEffects then follows the new default = the combine
# sink, so its output already reaches both devices).
move_streams_to() {
  local target="$1" id cur
  while read -r id cur; do
    [ -n "$id" ] || continue
    [ "$cur" = "$target" ] && continue
    case "$cur" in easyeffects_sink|easyeffects_*) continue ;; esac
    pactl move-sink-input "$id" "$target" 2>/dev/null || true
  done < <(pactl list short sink-inputs | awk '{print $1, $2}')
}

# The per-slave output nodes of a combine sink are ordinary PipeWire streams, so
# a session manager / EasyEffects can route one of them to the *default* sink
# instead of its intended slave -- which quietly silences that headset. Re-pin
# every "output.<sink>_<slave>" node onto its real slave.
fix_slave_links() {
  local slaves="$1" dump s ch out_nodes i
  if ! command -v pw-dump >/dev/null || ! command -v pw-link >/dev/null \
     || ! command -v pw-cli >/dev/null || ! command -v jq >/dev/null; then
    warn "pw-dump/pw-link/pw-cli/jq missing; skipping slave link verification"
    return 0
  fi

  # Wait (up to ~3 s) for the per-slave output nodes to materialise.
  for i in $(seq 1 20); do
    out_nodes="$(pw-dump 2>/dev/null | jq -r --arg p "output.${SINK_NAME}_" \
      '.[]|select(.type=="PipeWire:Interface:Node")
        | .info.props["node.name"] // empty | select(startswith($p))' 2>/dev/null)"
    [ -n "$out_nodes" ] && break
    sleep 0.15
  done
  [ -n "$out_nodes" ] || return 0

  dump="${STATE_FILE}.pw.json"
  pw-dump 2>/dev/null >"$dump" || { rm -f "$dump"; return 0; }

  # 1. destroy any link leaving a per-slave output that does not land on its slave
  jq -r --arg p "output.${SINK_NAME}_" '
      ([.[]|select(.type=="PipeWire:Interface:Node")
          |{(.id|tostring):(.info.props["node.name"]//"?")}]|add) as $n
      | .[]|select(.type=="PipeWire:Interface:Link")
      | ($n[(.info["output-node-id"]|tostring)]//"?") as $o
      | ($n[(.info["input-node-id"]|tostring)]//"?") as $i
      | select($o|startswith($p))
      | ($o|ltrimstr($p)) as $slave
      | select($i != $slave) | .id' "$dump" |
  while read -r i; do
    [ -n "$i" ] && pw-cli destroy "$i" >/dev/null 2>&1 || true
  done
  rm -f "$dump"

  # 2. (re)create the correct links, one per channel
  for s in ${slaves//,/ }; do
    for ch in FL FR; do
      pw-link "output.${SINK_NAME}_${s}:output_${ch}" "${s}:playback_${ch}" \
        >/dev/null 2>&1 || true
    done
  done
}

# ------------------------------------------------------------------- actions
do_list() {
  local found=0 name desc
  while IFS=$'\t' read -r name desc; do
    [ -n "$name" ] || continue
    found=1
    printf '  %-42s %s\n' "$name" "$desc"
  done < <(bt_sinks)
  [ "$found" = 1 ] || warn "no connected Bluetooth A2DP sinks found"
}

# Resolve selected sinks into a comma separated slave list.
resolve_slaves() {
  local name desc key hit line out=()
  while IFS=$'\t' read -r name desc; do
    [ -n "$name" ] || continue
    hit=0
    if [ "${#FILTERS[@]}" -eq 0 ]; then
      hit=1
    else
      for key in "${FILTERS[@]}"; do
        if [[ "${name,,}" == *"${key,,}"* || "${desc,,}" == *"${key,,}"* ]]; then
          hit=1; break
        fi
      done
    fi
    [ "$hit" = 1 ] && out+=("$name")
  done < <(bt_sinks)
  local IFS=,; echo "${out[*]:-}"
}

do_start() {
  local slaves
  slaves="$(resolve_slaves)"
  [ -n "$slaves" ] || die "no matching Bluetooth sink (run 'bt-duo-audio --list')"

  local n; n=$(awk -F, '{print NF}' <<<"$slaves")
  [ "$n" -ge 2 ] || warn "only one Bluetooth sink selected -- mirroring is a no-op"

  # Clean slate: drop any previous bt_duo module (keeps ids from piling up).
  do_stop_quiet

  if [ "$(default_sink)" != "$SINK_NAME" ]; then
    default_sink >"$STATE_FILE" || true
  fi

  local args="sink_name=$SINK_NAME slaves=$slaves"
  [ "$DO_COMPENSATE" = 1 ] && args+=" latency_compensate=1"
  [ -n "$LATENCY" ] && args+=" latency_msec=$LATENCY"

  info "Creating combine sink '$SINK_NAME' -> $slaves"
  pactl load-module module-combine-sink $args >/dev/null

  if [ "$DO_DEFAULT" = 1 ]; then
    pactl set-default-sink "$SINK_NAME"
    info "Default output is now '$SINK_NAME'"
  fi

  fix_slave_links "$slaves"

  if [ "$DO_MOVE" = 1 ]; then
    move_streams_to "$SINK_NAME"
    info "Moved existing streams to '$SINK_NAME'"
  fi

  if [ "$QUIET" = 1 ]; then
    summary "BT Duo: on ($n device$([ "$n" -eq 1 ] || echo s))"
  else
    echo
    info "Audio is mirrored to $n device(s). Play something!"
    info "Run 'bt-duo-audio --stop' to undo."
  fi
}

do_stop_quiet() {
  local m
  while read -r m; do
    [ -n "$m" ] && pactl unload-module "$m" 2>/dev/null || true
  done < <(combine_modules)
}

do_stop() {
  if [ -z "$(combine_modules)" ] && [ ! -f "$STATE_FILE" ]; then
    if [ "$QUIET" = 1 ]; then summary "BT Duo: off"; else info "Nothing to stop ('$SINK_NAME' is not running)."; fi
    return 0
  fi

  local target=""
  if [ -f "$STATE_FILE" ]; then
    target="$(cat "$STATE_FILE" 2>/dev/null || true)"
  fi
  # Only pick a fallback if we are the current default (never clobber a default
  # the user chose in the meantime).
  if [ -z "$target" ] && [ "$(default_sink)" = "$SINK_NAME" ]; then
    target="$(bt_sinks | head -1 | cut -f1)"
  fi

  if [ -n "$target" ]; then
    pactl set-default-sink "$target" 2>/dev/null || true
    move_streams_to "$target"
    info "Default output restored to '$target'"
  fi

  do_stop_quiet
  rm -f "$STATE_FILE"
  if [ "$QUIET" = 1 ]; then summary "BT Duo: off"; else info "Combine sink '$SINK_NAME' removed."; fi
}

do_status() {
  local m; m="$(combine_modules)"
  if [ -z "$m" ]; then
    info "Not running (no '$SINK_NAME' sink)."
    if [ "${#FILTERS[@]}" -eq 0 ] && [ -n "$(bt_sinks)" ]; then
      echo "Connected Bluetooth sinks:"; do_list
    fi
    return
  fi

  info "Active combine sink '$SINK_NAME' (module ${m//$'\n'/, })"
  echo "Default sink : $(default_sink)"
  echo "Mirroring to :"
  local s desc
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    desc="$(bt_sinks | awk -F'\t' -v n="$s" '$1==n{print $2}')"
    printf '  %-42s %s\n' "$s" "$desc"
  done < <(combine_slaves | tr ',' '\n')
  echo "Playing on '$SINK_NAME':"
  local any=0 id cur
  while read -r id cur; do
    [ "$cur" = "$SINK_NAME" ] && { any=1; echo "  sink-input #$id"; }
  done < <(pactl list short sink-inputs | awk '{print $1, $2}')
  [ "$any" = 1 ] || echo "  (nothing)"
}

# --------------------------------------------------------------------- main
case "$MODE" in
  list)   do_list ;;
  status) do_status ;;
  stop)      do_stop ;;
  start)     do_start ;;
  is-active) [ -n "$(combine_modules)" ] ;;
esac
