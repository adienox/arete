#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: ${0##*/} <file>" >&2
    exit 1
fi

file="$1"

if [[ ! -f "$file" ]]; then
    echo "Error: '$file' is not a regular file" >&2
    exit 1
fi

mv "$file" "${file}.bak"
cp "${file}.bak" "$file"
chmod +w "$file"

echo "Backed up '$file' → '${file}.bak' and made '$file' writable"
