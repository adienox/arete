				<key>invisibles</key>
				<string>{{colors.outline.default.hex}}</string>
				<key>lineHighlight</key>
				<string>{{colors.outline.default.hex}}55</string>
				<key>selection</key>
				<string>{{colors.surface_container_high.default.hex}}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Text</string>
			<key>scope</key>
