<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  matugen template -> bat theme (Sublime .tmTheme)

  Generated by matugen for `bat`. Base16 slots are split across two
  sources so the theme stays consistent with the rest of your dank16
  terminal palette while still getting proper depth for UI chrome:

    - UI chrome (bg/selection/comments/fg)  -> Material You surface tokens
    - Syntax highlighting (base08-base0F)    -> dank16 ANSI colors

  base16 slot -> source
    base00 background        -> colors.background
    base01 lighter bg         -> colors.surface_container
    base02 selection bg       -> colors.surface_container_high
    base03 comments           -> colors.outline
    base04 dark fg             -> colors.on_surface_variant
    base05 default fg          -> colors.on_surface
    base06 light fg            -> colors.on_surface
    base07 light bg            -> colors.surface_container_high
    base08 variables/tags      -> dank16.color1  (red)
    base09 numbers              -> dank16.color9  (bright red / orange slot)
    base0A classes               -> dank16.color3  (yellow)
    base0B strings                -> dank16.color2  (green)
    base0C regex/escapes           -> dank16.color6  (cyan)
    base0D functions                -> dank16.color4  (blue)
    base0E keywords/storage          -> dank16.color5  (magenta)
    base0F deprecated/embedded        -> dank16.color1  (red, reused)
-->
<plist version="1.0">
<dict>
	<key>author</key>
	<string>matugen + dank16 (DankMaterialShell)</string>
	<key>name</key>
	<string>Dank Matugen</string>
	<key>semanticClass</key>
	<string>theme.base16.dank-matugen</string>
	<key>colorSpaceName</key>
	<string>sRGB</string>
	<key>gutterSettings</key>
	<dict>
		<key>background</key>
		<string>{{colors.surface_container.default.hex}}</string>
		<key>divider</key>
		<string>{{colors.surface_container.default.hex}}</string>
		<key>foreground</key>
		<string>{{colors.outline.default.hex}}</string>
		<key>selectionBackground</key>
		<string>{{colors.surface_container_high.default.hex}}</string>
		<key>selectionForeground</key>
		<string>{{colors.on_surface_variant.default.hex}}</string>
	</dict>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>{{colors.background.default.hex}}</string>
