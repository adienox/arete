# name: 'matugen'

fish_color_normal {{colors.on_surface.default.hex_stripped}}
fish_color_command {{colors.primary.default.hex_stripped}}
fish_color_param {{colors.on_surface.default.hex_stripped}}
fish_color_keyword {{colors.tertiary.default.hex_stripped}}
fish_color_quote {{colors.secondary.default.hex_stripped}}
fish_color_redirection {{colors.tertiary.default.hex_stripped}}
fish_color_operator {{colors.tertiary.default.hex_stripped}}
fish_color_end {{colors.tertiary.default.hex_stripped}}
fish_color_error {{colors.error.default.hex_stripped}} --bold
fish_color_comment {{colors.outline.default.hex_stripped}}
fish_color_valid_path --underline
fish_color_autosuggestion {{colors.outline.default.hex_stripped}}
fish_color_search_match --background={{colors.surface_container_highest.default.hex_stripped}}
fish_color_selection --background={{colors.surface_container_highest.default.hex_stripped}}

fish_pager_color_prefix {{colors.primary.default.hex_stripped}} --bold --underline
fish_pager_color_completion {{colors.on_surface.default.hex_stripped}}
fish_pager_color_description {{colors.outline.default.hex_stripped}}
fish_pager_color_progress {{colors.on_surface_variant.default.hex_stripped}} --background={{colors.surface_container_high.default.hex_stripped}}
fish_pager_color_selected_background --background={{colors.surface_container_highest.default.hex_stripped}}
fish_pager_color_selected_prefix {{colors.primary.default.hex_stripped}} --bold
fish_pager_color_selected_completion {{colors.on_surface.default.hex_stripped}}
fish_pager_color_selected_description {{colors.on_surface_variant.default.hex_stripped}}