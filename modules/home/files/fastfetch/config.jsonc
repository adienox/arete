{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/lantern.txt",
    "color": {
      "1": "38;2;224;86;59",
      "2": "38;2;239;106;79",
      "3": "38;2;51;55;63",
      "4": "38;2;63;69;80",
      "5": "38;2;139;145;156",
      "6": "38;2;91;102;120",
      "7": "38;2;196;204;218"
    },
    "padding": { "top": 1, "left": 2, "right": 6 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;51;55;63"
    },
    "key": { "width": 10 }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "\u001b[38;2;51;55;63m── system ──────────────" },
    { "type": "os", "key": "  os", "format": "{pretty-name}" },
    { "type": "kernel", "key": "  kernel", "format": "{release}" },
    { "type": "uptime", "key": "  up" },
    { "type": "disk", "key": "  disk", "format": "{size-used}" },
    "break",
    { "type": "custom", "format": "\u001b[38;2;51;55;63m── rice ────────────────" },
    { "type": "wm", "key": "  wm", "format": "{pretty-name}" },
    { "type": "shell", "key": "  shell", "format": "{exe-name}" },
    { "type": "terminal", "key": "  term", "format": "{pretty-name}" },
    { "type": "command", "key": "  ts", "text": "n=$(tailscale status --active 2>/dev/null | wc -l); echo \"$n device$([ \"$n\" != 1 ] && echo s)\"" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
    "break"
  ]
}
