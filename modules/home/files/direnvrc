layout_uv() {
  if [[ -d ".venv" ]]; then
    VIRTUAL_ENV="$(pwd)/.venv"
  fi

  if [[ -z $VIRTUAL_ENV || ! -d $VIRTUAL_ENV ]]; then
    if [[ ! -f "pyproject.toml" ]]; then
      log_status "No uv project exists. Executing \`uv init\` to create one."
      uv init --no-readme
      rm main.py
      uv venv
    else
      uv sync
    fi
    VIRTUAL_ENV="$(pwd)/.venv"
  fi

  if [ -d ".venv/bin" ]; then
    PATH_add .venv/bin
  elif [ -d ".venv/Scripts" ]; then
    PATH_add .venv/Scripts
  fi
  export UV_ACTIVE=1 # or VENV_ACTIVE=1
  export VIRTUAL_ENV
}

layout_pio() {
  local bin_dir="$PWD/.direnv/bin"
  mkdir -p "$bin_dir"

  local real_clangd
  real_clangd="$(command -v clangd)"

  cat > "$bin_dir/clangd" << EOF
#!/usr/bin/env bash
# updating clangd to add pio packages
exec "$real_clangd" --query-driver='$HOME/.platformio/packages/**' "\$@"
EOF
  chmod +x "$bin_dir/clangd"

  PATH_add "$bin_dir"
}